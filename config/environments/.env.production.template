# Production Environment Template
# Copy to .env.production and fill with REAL values
# NEVER commit .env.production to git!

POSTGRES_DB=ummah_app_prod
POSTGRES_USER=ummah_prod_user
POSTGRES_PASSWORD=CHANGE_TO_SECURE_PRODUCTION_PASSWORD
POSTGRES_HOST=your-db-host.com
POSTGRES_PORT=5432

REDIS_PASSWORD=CHANGE_TO_SECURE_REDIS_PASSWORD
REDIS_HOST=your-redis-host.com
REDIS_PORT=6379

JWT_SECRET=CHANGE_TO_SECURE_JWT_SECRET_BASE64_ENCODED
ENCRYPTION_KEY=CHANGE_TO_SECURE_ENCRYPTION_KEY_BASE64

# API Configuration
API_PORT=8080
API_HOST=0.0.0.0

# Email Service (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-app-email@gmail.com
SMTP_PASSWORD=CHANGE_TO_APP_PASSWORD

# External APIs
PRAYER_TIMES_API_KEY=CHANGE_TO_YOUR_API_KEY
MAPS_API_KEY=CHANGE_TO_YOUR_MAPS_KEY
